# Port the TaskChaser server listens on.
PORT=4000

# Base URL that the three response links in the email point at.
# Must be reachable by the person receiving the email.
# Local team on the same LAN: use your machine's IP, e.g. http://192.168.1.20:4000
# Deployed: use the public https URL.
# On Vercel this can be left unset: the production domain is detected.
PUBLIC_BASE_URL=http://localhost:4000

# --- Storage -----------------------------------------------------------------
# Set BOTH of these to store data in InstantDB. This is what makes a serverless
# deployment (Vercel) actually keep your data. Leave them unset and the app
# falls back to the local JSON file below.
#
# The App ID is public and safe to share. The admin token is a SECRET: it grants
# full read/write over the whole app, so keep it out of version control and set
# it as an environment variable on your host.
# INSTANT_APP_ID=
# INSTANT_ADMIN_TOKEN=

# Where the JSON data file lives, used only when Instant is not configured.
# On a host with a persistent volume, point this at the mounted path so the
# data survives restarts.
DATA_DIR=./data

# Set to 1 when running behind a reverse proxy that terminates TLS, so the
# email links are built with https rather than http. Automatic on Vercel.
# TRUST_PROXY=1
