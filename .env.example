# Port the TaskChaser server listens on.
PORT=4000

# Base URL that the three response links in the email point at.
# Must be reachable by the person receiving the email.
# Local team on the same LAN: use your machine's IP, e.g. http://192.168.1.20:4000
# Deployed: use the public https URL.
PUBLIC_BASE_URL=http://localhost:4000

# Where the JSON data file lives.
DATA_DIR=./data
