{
  "name": "taskchaser",
  "version": "1.0.0",
  "private": true,
  "description": "Assign tasks, chase them over email, and watch the answers land on your dashboard.",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server run start",
    "typecheck": "npm --workspace client run typecheck",
    "test": "node --test \"server/src/**/*.test.js\" \"client/src/**/*.test.ts\""
  },
  "devDependencies": {
    "@instantdb/admin": "^1.0.65",
    "concurrently": "^9.1.2"
  }
}
